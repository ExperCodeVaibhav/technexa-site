# At least 20 characters. Store the real value as a Vercel Secret.
ADMIN_KEY=

# Comma-separated browser origins allowed to read/write the CMS API.
ALLOWED_ORIGINS=https://expercodevaibhav.github.io,https://technexasolutions.in,https://www.technexasolutions.in,http://localhost:3000,http://127.0.0.1:3000

# Current private-store connection (used by the existing deployment).
BLOB_READ_WRITE_TOKEN=

# New private Blob connections may use OIDC plus this store identifier instead.
BLOB_STORE_ID=
